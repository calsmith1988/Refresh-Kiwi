# Cursor cloud agents
CURSOR_API_KEY=cursor_your_api_key_here
CURSOR_SITES_REPO_URL=https://github.com/your-org/refresh-kiwi-sites

# Optional GitHub fallback for private CURSOR_SITES_REPO_URL repos
GITHUB_TOKEN=github_pat_with_contents_read_access

# Postgres (Render or local)
# Render Postgres requires SSL — append ?sslmode=require if not in the URL
DATABASE_URL=postgresql://user:password@host:5432/refresh_kiwi?sslmode=require

# App URL used for Stripe redirects
NEXT_PUBLIC_APP_URL=https://refresh-kiwi.onrender.com

# Render custom domains
RENDER_API_KEY=rnd_your_render_api_key
RENDER_SERVICE_ID=srv_your_refresh_kiwi_service_id
RENDER_DNS_TARGET=refresh-kiwi.onrender.com

# Transactional email
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Refresh Kiwi <hello@yourdomain.com>

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRO_PRICE_ID=price_your_monthly_pro_plan
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
