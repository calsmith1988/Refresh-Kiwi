# Cursor cloud agents
CURSOR_API_KEY=cursor_your_api_key_here
CURSOR_SITES_REPO_URL=https://github.com/your-org/refresh-kiwi-sites

# Google Business Profile imports via Places API (New)
# Server-side only. Enable Places API (New), restrict the key to that API, and
# set quota caps/budget alerts in Google Cloud.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Optional GitHub fallback for private CURSOR_SITES_REPO_URL repos
GITHUB_TOKEN=github_pat_with_contents_read_access

# Cloudflare R2 storage for generated previews and assets
R2_ACCOUNT_ID=your_cloudflare_account_id
# Optional explicit endpoint override, e.g. https://accountid.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=refresh-kiwi-sites
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Postgres (Render or local)
# Render Postgres requires SSL — append ?sslmode=require if not in the URL
DATABASE_URL=postgresql://user:password@host:5432/refresh_kiwi?sslmode=require

# Max Postgres connections per process (web instance or worker). Render
# Starter allows ~97 total, so keep max * process count well under that.
# Raise only after switching DATABASE_URL to a pooled connection string
# (PgBouncer / Render connection pooling).
DB_POOL_MAX=5

# Shared rate limiting (Render Key Value / Redis-compatible URL)
# Leave unset locally to use in-memory development limits.
RATE_LIMIT_REDIS_URL=rediss://default:password@host:6379

# App URL used for Stripe redirects
NEXT_PUBLIC_APP_URL=https://refresh-kiwi.onrender.com

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0J6KNZCKDF
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_CONVERSIONS_API_ACCESS_TOKEN=your_meta_conversions_api_access_token
META_TEST_EVENT_CODE=TEST12345

# Render custom domains
RENDER_API_KEY=rnd_your_render_api_key
RENDER_SERVICE_ID=srv_your_refresh_kiwi_service_id
RENDER_DNS_TARGET=refresh-kiwi.onrender.com

# Transactional email
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Refresh Kiwi <hello@yourdomain.com>
# Required in production (min 16 chars) — unsubscribe links are HMAC-signed
# with this and there is no fallback.
EMAIL_UNSUBSCRIBE_SECRET=random_long_secret_for_unsubscribe_links

# Render cron jobs
CRON_SECRET=random_long_secret_for_cron_requests

# Internal-only debug/health endpoints (falls back to CRON_SECRET when unset)
INTERNAL_API_SECRET=random_long_secret_for_internal_endpoints

# HMAC secret for anonymous job polling tokens (falls back to CRON_SECRET when unset)
JOB_ACCESS_SECRET=random_long_secret_for_job_access_tokens

# Number of trusted reverse proxies in front of the app (Render = 1). Used to
# pick the real client IP from X-Forwarded-For without trusting spoofed hops.
TRUSTED_PROXY_COUNT=1

# Cloudflare Turnstile (anti-abuse on anonymous generation). Leave unset to
# disable the challenge entirely (e.g. local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rolling 24h cap on paid edit/agent runs per user (defaults to 50)
PRO_DAILY_EDIT_LIMIT=50

# Render background worker tuning
WORKER_IDLE_SLEEP_MS=5000
WORKER_RECOVERY_INTERVAL_MS=60000

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRO_PRICE_ID=price_your_monthly_pro_plan
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# OpenAI image remixing and text generation for starter legal pages
OPENAI_API_KEY=sk_your_openai_key
OPENAI_TEXT_MODEL=o4-mini
