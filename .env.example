# Cursor cloud agents
CURSOR_API_KEY=cursor_your_api_key_here
CURSOR_SITES_REPO_URL=https://github.com/your-org/refresh-kiwi-sites

# Optional GitHub fallback for private CURSOR_SITES_REPO_URL repos
GITHUB_TOKEN=github_pat_with_contents_read_access

# Postgres (Render or local)
# Render Postgres requires SSL — append ?sslmode=require if not in the URL
DATABASE_URL=postgresql://user:password@host:5432/refresh_kiwi?sslmode=require
